# Dependencies — reinstalled inside Docker
node_modules
backend/node_modules
frontend/node_modules

# Compiled outputs — rebuilt inside Docker
**/dist
**/.next
**/out

# Secrets — NEVER leak into build context
**/.env
**/.env.local
**/.env.*.local

# Frontend — not needed in backend Docker image
frontend/

# Logs
**/*.log
npm-debug.log*

# Git / IDE
.git
.gitignore
.vscode
.idea

# OS
.DS_Store
Thumbs.db
