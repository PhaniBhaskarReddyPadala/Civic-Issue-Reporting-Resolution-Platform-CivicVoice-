# ============================================================
# CivicVoice Backend — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real credentials below
#   3. NEVER commit the .env file — it is in .gitignore
# ============================================================

# ------------------------------------
# Server
# ------------------------------------
PORT=5000

# ------------------------------------
# PostgreSQL (Prisma / Neon)
# Get your connection string from: https://neon.tech/
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# ------------------------------------
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_NEON_HOST/YOUR_DB_NAME?sslmode=require&channel_binding=require&connect_timeout=30"

# ------------------------------------
# MongoDB (Mongoose / Atlas)
# Get your URI from: https://cloud.mongodb.com/
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# ------------------------------------
MONGODB_URI="mongodb+srv://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@YOUR_CLUSTER.mongodb.net/civicflow?retryWrites=true&w=majority"

# ------------------------------------
# JWT Auth Secret
# Use a long, random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING"

# ------------------------------------
# Cloudinary (Optional — for image CDN)
# If left empty, images fall back to base64 storage in MongoDB.
# Get credentials from: https://cloudinary.com/console
# ------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
